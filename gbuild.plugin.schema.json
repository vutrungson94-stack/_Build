{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://github.com/gbuild/_Build/gbuild.plugin.schema.json",
    "title": "gbuild plugin manifest",
    "description": "Formal sidecar manifest for a gbuild language plugin (<Name>.plugin.json next to <Name>.psm1). Validated by PluginSDK.psm1 Test-PluginManifest.",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "name",
        "version"
    ],
    "properties": {
        "$schema": {
            "type": "string",
            "description": "Path or URL to this schema file."
        },
        "name": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
            "description": "Plugin name. Must match the entry registered via Get-PluginInfo."
        },
        "version": {
            "type": "string",
            "pattern": "^v?\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?(\\+[A-Za-z0-9.-]+)?$",
            "description": "Plugin semantic version."
        },
        "apiVersion": {
            "type": "string",
            "pattern": "^v?\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?(\\+[A-Za-z0-9.-]+)?$",
            "description": "Plugin SDK contract version this plugin was built against (default: current SDK)."
        },
        "minGbuildVersion": {
            "type": "string",
            "pattern": "^v?\\d+\\.\\d+\\.\\d+(-[A-Za-z0-9.-]+)?(\\+[A-Za-z0-9.-]+)?$",
            "description": "Minimum gbuild tool version required (BuildConstants.Version)."
        },
        "maxGbuildVersion": {
            "type": "string",
            "description": "Maximum gbuild tool version allowed (empty = unbounded). Semver when set."
        },
        "author": {
            "type": "string"
        },
        "description": {
            "type": "string"
        },
        "supportedLanguages": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "description": "Languages this plugin handles (must match LanguageDetector names)."
        },
        "priority": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5,
            "description": "Dispatch priority 1..10 (lower wins on overlap; Avalonia=10)."
        },
        "dependencies": {
            "type": "array",
            "description": "Other plugins that must load first.",
            "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                    "name": { "type": "string" },
                    "version": { "type": "string", "description": "Semver constraint (exact, >=, ^, ~, ranges, or *)." }
                }
            }
        },
        "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["build", "test", "lint", "preflight", "clean", "run", "security", "policy", "supply-chain"] },
            "description": "Lifecycle hooks this plugin implements."
        },
        "entryPoint": {
            "type": "string",
            "description": "Plugin module file name (e.g. Node.psm1)."
        }
    }
}
