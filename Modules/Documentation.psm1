# -- Show CLI help -------------------------------------------------------------
<#
.SYNOPSIS
    Displays comprehensive help information for the gbuild system.
.DESCRIPTION
    Shows usage examples, available options, subcommands, and interactive menu.
#>
function Show-GBuildHelp {
    [CmdletBinding()]
    param([switch]$Modules)

Set-StrictMode -Version 1.0

    # Location-correct examples: the tool dir is the parent of Modules/
    # (never a hardcoded "_Build"), rendered relative to the caller's cwd.
    $toolRoot = try { (Split-Path $PSScriptRoot -Parent) } catch { '' }
    $helpCwd = try { ((Get-Location).ProviderPath) } catch { '' }
    $invoke = '.\_Build\gbuild.ps1'
    if (Get-Command Get-InvokeCommandHint -ErrorAction SilentlyContinue) {
        try { $invoke = Get-InvokeCommandHint -ScriptRoot $toolRoot -FromDirectory $helpCwd } catch { }
    } else {
        try {
            $__w = Get-Variable -Name IsWindows -ValueOnly -ErrorAction SilentlyContinue
            $isW = if ($null -ne $__w) { [bool]$__w } else { (Test-IsWindowsHost) }
            if (-not $isW) { $invoke = './_Build/gbuild' }
        } catch { }
    }
    if ($invoke -like './*') {
        $exampleProj = '$HOME/projects/MyApp'
        $cdCmd = 'cd $HOME/projects/MyApp'
    } else {
        # No literal drive letter: $HOME works on Windows PowerShell too
        # ($HOME is defined on every supported host), so the example stays valid
        # when copied verbatim instead of rotting on machines without D:.
        $exampleProj = '$HOME\projects\MyApp'
        $cdCmd = 'Set-Location "$HOME\projects\MyApp"'
    }
    $helpTopic = "$invoke".Replace('\', '/')
    $helpText = @"
gbuild - PowerShell Build System

USAGE:
    $invoke <project-path> [options]      # from any directory
    $invoke [options]                     # from INSIDE a project directory (auto-detect)

PROJECT CONTEXT (required to build):
    Position 0:  the project folder / .csproj / solution path.
    -Project <path>    Same as the position-0 argument (explicit alias).
    If no project is given, gbuild auto-detects from the current directory;
    run from a directory that IS a project root (contains *.csproj, package.json,
    Cargo.toml, go.mod, pyproject.toml, pom.xml, *.sln, ...).

BUILD OPTIONS:
    -Target <id>         Pick a menu target (e.g. 2 = Publish Android APK, 3 = AAB, ...)
    -Target list         List all targets with purpose + engine modules (no project needed)
    -Incremental / -i    Skip clean step (faster rebuilds)
    -Clean / -c          Run smart clean only (no build)
    -NonInteractive      Run in non-interactive mode
    -GitHub / -gh        Trigger GitHub Actions cloud build
-LogLevel <level>    Error | Warn | Info | Debug (default: Info)
    -Locale / -lang <code> Display language (e.g. en, vi, de, es, fr, ja, zh)
    -Locale list         List languages + switch guide (no project needed)

LANGUAGE TIP:
    TIP: run '$invoke -Locale list' for supported languages and the location-correct switch command.
    Supported: en, vi, de, es, fr, ja, zh. Locale selection is applied to build messages only.

STANDALONE COMMANDS (no project needed):
    -Help / -h           Show this help
    -License / -lic      Show license and copyright information
    -VerifyInfra / vrf   Run infrastructure/health verification (doctor-style)
    -CacheStats          Show build cache statistics
    -CacheClear / -cc    Clear all build cache entries
    -CacheOptimize / -co Optimize cache (LRU cleanup)
    -VersionBump [type]  Bump version (major|minor|patch|rc|beta)
    -Security / -sec     Run security scan (secrets + vulnerabilities)
    -Distributed / -dist Distributed build
    -SyntaxCheck         Parse and analyze only (no build, no test)
    -SelfTest           Run the platform's own self-verification (no build)

EXAMPLES:
    $invoke "$exampleProj"           # Interactive build menu
    $invoke "$exampleProj" -Target 2 # Publish Android APK directly
    $invoke "$exampleProj" -Target list # List all targets + purpose + engines
    $invoke "$exampleProj" -Clean    # Smart clean that project
    $cdCmd; $invoke -Incremental   # Build from inside the project
    $invoke -CacheStats                   # Show cache info (no project)
    $invoke -License                      # Show copyright & license (no project)
    $invoke -VersionBump minor            # Bump minor version (no project)
    $invoke "$exampleProj" -Security # Security audit
    $invoke "$exampleProj" -Locale vi # Build with Vietnamese messages

OPTIONAL FEATURES (disabled by default; skipping them is not an error):
    Affected projects  build.affected.enabled
    AutoTune           autoTune.enabled=true and autoTune.autoApply=true
    Standalone bundle  build.standalone.enabled
    Publish artifact   build.publishArtifact.enabled
    Use -LogLevel Debug to show the per-build skipped-step summary.

INTERACTIVE MENU:
    [1-12,14-16] Build / parallel / AOT / Avalonia targets
    [T/I]       Non-.NET test / lint (plugin dispatch)
    [A/B/V/G/P/F/E/K/Y/N] Deploy targets (registry-driven)
    [X]         Distributed build (requires distributed.enabled=true)
    [Z]         Chaos suite (opt-in, chaos.enabled)
    [M]         Anomaly report (anomaly.enabled=true)
    [O]         Multi-cluster status (requires build.cluster.enabled=true)
    [Q]         Custom: build environment summary (config customEntries)
    [W]         Hot Reload (dotnet watch)
    [D]         Doctor (health check)
    [S]         Security scan
    [H/R/C/L]   Help / Report / Cache / Changelog
    [13]        GitHub Cloud Build
    [0]         Exit

STEPS (Steps/ — wiring):
    publish-artifact.ps1    AUTO via Build.PublishArtifact step (build.publishArtifact.enabled)
    sign-gpg.ps1            AUTO via DeployTargets.Invoke-GpgSign (security.gpgSign.enabled)
    vulnerability-scan.ps1  REMOVED - it duplicated the wired SastScan step
                            (Modules/Sast.psm1) command for command: the same
                            `dotnet list <proj> package --vulnerable
                            --include-transitive` and `npm audit --json`, over a
                            STRICTLY SMALLER ecosystem set, with no pipeline
                            caller, and an "AI-Powered" remediation helper that
                            contained no AI. Sast is the single owner and also
                            carries the scan-root containment + reparse guards.
    manage-githooks.ps1     MANUAL utility (governed, not orphan): . ./Steps/manage-githooks.ps1 -Install/-Remove/-List
    pipeline-diagram.ps1    MANUAL utility (governed, not orphan): . ./Steps/pipeline-diagram.ps1 (writes build-reports/pipeline-diagram.md)

For more info, see README.md or run:    Get-Help $helpTopic
Copyright (c) 2026 Vu Trung Son (vutrungson94@gmail.com) - MIT License. Run '$invoke -License'.
"@
    if (Get-Command Write-Log -ErrorAction SilentlyContinue) {
        Write-Log $helpText 'White' $null
    } elseif (Get-Command Write-Host -ErrorAction SilentlyContinue) {
        Write-Host $helpText
    }

    # -Modules: generates the API reference (module/function inventory) via Documentation API.
    if ($Modules) {
        $buildRoot = Split-Path -Parent $PSScriptRoot
        $docsDir = Join-Path $buildRoot 'Docs'
        $docPath = Join-Path $docsDir 'api-reference.md'
        # Per-module pages are emitted from the SAME parse pass, so Docs\API\ is
        # generated output (referenced by the index) rather than an orphan tree.
        $perModuleDir = Join-Path $docsDir 'API'
        $generated = New-ModuleDocumentation -ModulesDir $PSScriptRoot -OutputPath $docPath -PerModuleDir $perModuleDir
        if ($generated) {
            $files = @(Get-ChildItem -Path $PSScriptRoot -Filter '*.psm1' -File -Recurse -ErrorAction SilentlyContinue)
            $totalFuncs = 0
            foreach ($f in $files) {
                $totalFuncs += @(Get-ModuleFunctions -ModulePath $f.FullName -ModuleName ([System.IO.Path]::GetFileNameWithoutExtension($f.Name))).Count
            }
            $pageCount = @(Get-ChildItem -LiteralPath $perModuleDir -Filter '*.md' -File -ErrorAction SilentlyContinue).Count
            $msg = "[DOCS] API reference: $($files.Count) modules, $totalFuncs functions -> $generated (+$pageCount per-module pages)"
            if (Get-Command Write-Log -ErrorAction SilentlyContinue) { Write-Log $msg 'Info' $null } else { Write-Host $msg }
        } else {
            if (Get-Command Write-Log -ErrorAction SilentlyContinue) { Write-Log (Resolve-LogMessage -Key 'log.docs.apiRefFailed' -Fallback '[DOCS] Failed to generate API reference') 'Warn' $null }
        }
    }
}

