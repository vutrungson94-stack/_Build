# -- Parse functions from a module file --------------------------------------
<#
.SYNOPSIS
    Parses function definitions and their parameters from a PowerShell module file.
.DESCRIPTION
    Uses the PowerShell parser AST to find every function definition in the
    target file and returns one object per function with its name, owning
    module name, and the parameter list (name : type). Returns an empty array
    when the file is missing or fails to parse.
.PARAMETER ModulePath
    Path to the .psm1 file to parse.
.PARAMETER ModuleName
    The logical module name to stamp on each returned function object.
.OUTPUTS
    pscustomobject[]
#>
function Get-ModuleFunctions {
    [CmdletBinding()]
    param(
        [string]$ModulePath,
        [string]$ModuleName
    )
    if (-not (Test-Path $ModulePath)) { return @() }

    $content = Get-Content -Path $ModulePath -Raw -Encoding UTF8
    $tokens = $null
    $errors = $null
    $ast = [System.Management.Automation.Language.Parser]::ParseInput($content, [ref]$tokens, [ref]$errors)
    if ($errors -and $errors.Count -gt 0) { return @() }

    $funcs = @()
    foreach ($fn in $ast.FindAll({ param($n) $n -is [System.Management.Automation.Language.FunctionDefinitionAst] }, $true)) {
        $params = @()
        if ($fn.Body -and $fn.Body.ParamBlock -and $fn.Body.ParamBlock.Parameters) {
            foreach ($p in $fn.Body.ParamBlock.Parameters) {
                $typeName = if ($p.StaticType) { $p.StaticType.Name } else { '' }
                $params += "$($p.Name.VariablePath.UserPath)$(if ($typeName) { " :$typeName" })"
            }
        }
        $funcs += [PSCustomObject]@{
            Name       = $fn.Name
            ModuleName = $ModuleName
            Parameters = $params
            Synopsis   = ''
        }
    }
    return $funcs
}

# -- Generate API documentation -------------------------------------------------
<#
.SYNOPSIS
    Generates a Markdown API reference from a directory of PowerShell modules.
.DESCRIPTION
    Scans every *.psm1 file under ModulesDir (recursively, so Modules\Plugins and
    Modules\Providers are covered too) and emits, per module, a '## <ModuleName>'
    heading and one '### <FunctionName>' heading with its parameter list.

    Two artefacts are produced from ONE parse pass:
      * OutputPath          - the aggregated reference (Docs\api-reference.md)
      * Docs\API\<Module>.md - the per-module page, when -PerModuleDir is supplied

    The per-module directory used to be a committed, unreferenced tree of 74 files
    that no generator produced and nothing read. Emitting it from the same pass
    makes it real output instead of an orphan, and the index links into it.
.PARAMETER ModulesDir
    Directory containing the *.psm1 files to document.
.PARAMETER OutputPath
    Destination Markdown file path for the aggregated reference.
.PARAMETER PerModuleDir
    Optional directory to receive one Markdown file per module.
.OUTPUTS
    string (path to the aggregated file) or $null on failure.
#>
function New-ModuleDocumentation {
    [CmdletBinding()]
    param(
        [string]$ModulesDir,
        [string]$OutputPath,
        [string]$PerModuleDir
    )
    if (-not (Test-Path $ModulesDir)) { return $null }

    $sb = [System.Text.StringBuilder]::new()
    [void]$sb.AppendLine('# gbuild API reference')
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('<!-- GENERATED by Modules\Documentation.psm1 (Show-GBuildHelp -Modules). Do not edit by hand. -->')
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('Per-module pages live in [Docs/API](API/).')
    [void]$sb.AppendLine('')

    # Recursive: Plugins\ and Providers\ are first-class modules too.
    $files = @(Get-ChildItem -Path $ModulesDir -Filter '*.psm1' -File -Recurse -EA SilentlyContinue |
                 Sort-Object -Property FullName)
    $index = [System.Collections.Generic.List[string]]::new()
    $writtenPages = [System.Collections.Generic.HashSet[string]]::new([System.StringComparer]::OrdinalIgnoreCase)
    $moduleTotal = 0
    $funcTotal = 0
    foreach ($f in $files) {
        $moduleName = [System.IO.Path]::GetFileNameWithoutExtension($f.Name)
        $funcs = @(Get-ModuleFunctions -ModulePath $f.FullName -ModuleName $moduleName)
        if ($funcs.Count -eq 0) { continue }
        $moduleTotal++
        $funcTotal += $funcs.Count

        [void]$sb.AppendLine("## $moduleName")
        [void]$sb.AppendLine('')
        $page = [System.Text.StringBuilder]::new()
        [void]$page.AppendLine("# $moduleName")
        [void]$page.AppendLine('')
        [void]$page.AppendLine("$($funcs.Count) function(s). Source: ``Modules/$($f.FullName.Substring($ModulesDir.Length).TrimStart('\','/').Replace('\','/'))``")
        [void]$page.AppendLine('')
        foreach ($fn in $funcs) {
            [void]$sb.AppendLine("### $($fn.Name)")
            [void]$sb.AppendLine('')
            [void]$page.AppendLine("### $($fn.Name)")
            [void]$page.AppendLine('')
            $plist = @($fn.Parameters)
            if ($plist.Count -gt 0) {
                $paramLine = 'Parameters: ' + ($plist -join ', ')
                [void]$sb.AppendLine($paramLine)
                [void]$page.AppendLine($paramLine)
                [void]$sb.AppendLine('')
                [void]$page.AppendLine('')
            }
        }
        [void]$sb.AppendLine('')
        $index.Add("| [$moduleName](API/$moduleName.md) | $($funcs.Count) |") | Out-Null

        if ($PerModuleDir) {
            try {
                if (-not (Test-Path -LiteralPath $PerModuleDir -PathType Container)) {
                    $null = New-Item -ItemType Directory -Path $PerModuleDir -Force -EA Stop
                }
                $pagePath = Join-Path $PerModuleDir "$moduleName.md"
                # Replace the whole file so a removed function cannot linger.
                [System.IO.File]::WriteAllText($pagePath, ($page.ToString() + "`r`n"), (New-Object System.Text.UTF8Encoding($false)))
                [void]$writtenPages.Add("$moduleName.md")
            } catch {
                if (Get-Command Write-Log -ErrorAction SilentlyContinue) { Write-Log (Resolve-LogMessage -Key 'log.docs.pageWriteFailed' -MessageArgs @([string]$moduleName, [string]$_) -Fallback '[DOCS] Could not write {0} page: {1}') 'Warn' $null }
            }
        }
    }

    # Prune pages for modules that no longer exist. Without this, deleting a module
    # leaves a documentation page behind that describes code which is gone (the
    # tree had accumulated exactly such a page for a module that never shipped).
    if ($PerModuleDir -and (Test-Path -LiteralPath $PerModuleDir -PathType Container)) {
        foreach ($stale in @(Get-ChildItem -LiteralPath $PerModuleDir -Filter '*.md' -File -EA SilentlyContinue)) {
            if (-not $writtenPages.Contains($stale.Name)) {
                Remove-Item -LiteralPath $stale.FullName -Force -EA SilentlyContinue
                if (Get-Command Write-Log -ErrorAction SilentlyContinue) { Write-Log (Resolve-LogMessage -Key 'log.docs.stalePageRemoved' -MessageArgs @([string]$stale.Name) -Fallback '[DOCS] Removed stale page for missing module: {0}') 'Info' $null }
            }
        }
    }

    [void]$sb.AppendLine('## Index')
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine('| Module | Functions |')
    [void]$sb.AppendLine('| --- | --- |')
    foreach ($row in $index) { [void]$sb.AppendLine($row) }
    [void]$sb.AppendLine('')
    [void]$sb.AppendLine("Total: $moduleTotal module(s), $funcTotal function(s).")

    try {
        $parent = Split-Path -Parent $OutputPath
        if ($parent -and -not (Test-Path -LiteralPath $parent -PathType Container)) {
            $null = New-Item -ItemType Directory -Path $parent -Force -EA Stop
        }
        [System.IO.File]::WriteAllText($OutputPath, ($sb.ToString() + "`r`n"), (New-Object System.Text.UTF8Encoding($false)))
        return $OutputPath
    } catch {
        return $null
    }
}

Export-ModuleMember -Function @('Show-GBuildHelp', 'Get-ModuleFunctions', 'New-ModuleDocumentation')
